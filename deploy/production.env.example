# ═══════════════════════════════════════════════════════════════════════════
# UDF backend — PRODUCTION environment template
# ═══════════════════════════════════════════════════════════════════════════
# Copy to the server as /etc/udf/udf-api.env (root-owned, chmod 600) and load
# it from the systemd unit via EnvironmentFile=. Fill every CHANGE_ME.
#
#   sudo install -d -m 750 /etc/udf
#   sudo cp production.env.example /etc/udf/udf-api.env
#   sudo chown root:udf /etc/udf/udf-api.env && sudo chmod 640 /etc/udf/udf-api.env
#   sudo nano /etc/udf/udf-api.env
#
# NEVER commit the filled-in file. Placeholders below are not real secrets.
# Target host: https://crm.udf-party.co.za (Let's Encrypt cert).
# The legacy IP path https://102.68.98.129 (self-signed) keeps working — see
# deploy/nginx/block-direct-ip.conf and RUNBOOK §15.
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=4000
# Bind to loopback ONLY — nginx reverse-proxies /api to 127.0.0.1:4000, so the
# API is never directly reachable from the internet.
HOST=127.0.0.1
LOG_LEVEL=info

# Allowed browser/WebView origins (comma-separated, no trailing slash):
#   • https://crm.udf-party.co.za    — the public app/CRM origin (Let's Encrypt).
#   • https://udf-party.co.za        — the apex marketing site. Its udf-content.js
#     hydrates the councillor roster + CMS blocks by fetching /api/public/* on the
#     CRM origin, so this MUST be allowed or the public cards silently stay as the
#     name-only static fallback and never show uploaded photos (CORS-blocked).
#   • https://www.udf-party.co.za    — www alias of the marketing site.
#   • https://102.68.98.129          — legacy self-signed IP path (older APKs).
#   • http://localhost               — the Capacitor Android WebView origin
#     (androidScheme 'http'); REQUIRED for the mobile app's cross-origin calls.
CORS_ORIGINS=https://crm.udf-party.co.za,https://udf-party.co.za,https://www.udf-party.co.za,https://102.68.98.129,http://localhost

# ── Database ────────────────────────────────────────────────────────────────
# Local PostgreSQL + PostGIS. Use a dedicated role/db (NOT the postgres superuser
# and NOT the mail server's databases). Strong password → CHANGE_ME.
DATABASE_URL=postgres://udf:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/udf
# Loopback connection needs no TLS; set true only for a remote/managed DB.
PGSSL=false

# ── Auth: RS256 key pair (REQUIRED in production) ───────────────────────────
# systemd EnvironmentFile cannot hold multi-line PEM, so reference the key FILES
# by path. Generate them with deploy/scripts/gen-keys.sh (chmod 600, root/udf).
JWT_PRIVATE_KEY_PATH=/etc/udf/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/etc/udf/jwt_public.pem
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# ── Layer 3: field-level envelope encryption (KEK) ──────────────────────────
# Single-VM deploy → "local" KEK. For multi-region/managed HSM use "aws-kms".
# LOCAL_KEK (64 hex) is GENERATED into /etc/udf/secrets.env by
# deploy/scripts/gen-secrets.sh, which systemd loads as a second EnvironmentFile
# (so the value is never printed or committed). You may set it here instead, but
# it MUST be 64 hex chars or the API refuses to boot.
KMS_PROVIDER=local
# LOCAL_KEK=
# AWS KMS alternative (when KMS_PROVIDER=aws-kms):
# AWS_REGION=af-south-1
# AWS_KMS_KEY_ID=arn:aws:kms:af-south-1:123456789012:key/xxxxxxxx

# ── Blind index (HMAC) key — REQUIRED in production ─────────────────────────
# 64 hex chars (32 bytes). Separate from the KEK so each can rotate alone.
# Also GENERATED into /etc/udf/secrets.env by gen-secrets.sh. Losing it makes
# sealed-email equality lookups unrecoverable — back it up with the KEK.
# BLIND_INDEX_KEY=

# ── Layer 1: in transit ─────────────────────────────────────────────────────
# HSTS is ON because crm.udf-party.co.za carries a publicly trusted Let's Encrypt
# cert. Keep this FALSE on any host still serving only the self-signed IP cert
# (browsers would pin an untrusted cert).
ENABLE_HSTS=true

# Public web origin used to build membership / mandate confirmation links
# (QR card, outbox emails). Match the address users actually visit.
PUBLIC_BASE_URL=https://crm.udf-party.co.za

# ═══════════════════════════════════════════════════════════════════════════
# Super-admin bootstrap — consumed ONLY by `npm run seed:admin`, not the API.
# Keep these OUT of the runtime env on a normal boot; provide them inline for
# the one-time seed command (see RUNBOOK), then they are not needed again.
# Do NOT commit real values.
# ═══════════════════════════════════════════════════════════════════════════
# SUPERADMIN_EMAIL=changeme@example.org
# SUPERADMIN_PASSWORD=CHANGE_ME_strong_password_min_10_chars
# SUPERADMIN_NAME=National Administrator
# SUPERADMIN_ROLE: national_admin (default) or superadmin. Use `superadmin` for
# the platform owner — a strict superset of national_admin that also unlocks the
# ops surface (server/cron/live status, first-party analytics, website content
# editor). Every other staff account should stay on a scoped role.
SUPERADMIN_ROLE=superadmin
# SUPERADMIN_REGION_CODES=            # empty => national scope
# SUPERADMIN_WARD_CODE=

# ═══════════════════════════════════════════════════════════════════════════
# Outbound email (FR-Q) — onboarding OTP + starter pack (now WIRED).
# The mailer (src/security/mailer.ts) delivers via SMTP. This VM already runs
# postfix on loopback, so the defaults need NO credentials or TLS: the app hands
# the message to 127.0.0.1:25 and postfix relays it, signing DKIM through the
# on-box opendkim milter. MAIL_FROM is the ONLY required key — if it is empty
# the app REFUSES to boot in production (see config/env.ts), and in dev it
# captures mail to the `email_outbox` table instead of sending.
#
# MAIL_FROM must be a real, DKIM-aligned address (the From: header users see).
# KEEP THE DOUBLE QUOTES — this file is read both by systemd EnvironmentFile=
# and by `set -a; . /etc/udf/udf-api.env` in the RUNBOOK's on-box steps. The
# shell chokes on unquoted `<` and spaces (see RUNBOOK §6 pitfall 2).
MAIL_FROM="UDF Party <no-reply@udf-party.co.za>"
# Optional envelope bounce address; defaults to MAIL_FROM's address.
# MAIL_RETURN_PATH=no-reply@udf-party.co.za
#
# Local postfix relay (DEFAULT — leave as-is for the on-box relay):
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
SMTP_STARTTLS=false
#
# Remote/managed relay alternative (e.g. a 587 submission host with auth):
#   SMTP_HOST=smtp.CHANGE_ME_PROVIDER
#   SMTP_PORT=587
#   SMTP_SECURE=false        # true ONLY for implicit TLS on 465
#   SMTP_STARTTLS=true       # upgrade a 587 plaintext socket to TLS
#   SMTP_USER=CHANGE_ME
#   SMTP_PASS=CHANGE_ME      # keep this in /etc/udf/secrets.env, not here
# ═══════════════════════════════════════════════════════════════════════════
