{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/check-caps.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "caps:check": "node scripts/check-caps.mjs",
    "prebuild:mobile": "node scripts/check-caps.mjs",
    "build:mobile": "cross-env NEXT_EXPORT=1 next build",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "android:assets": "node scripts/prepare-android-assets.mjs",
    "apk": "npm run build:mobile && npm run cap:sync && npm run android:assets && cd android && ./gradlew assembleDebug",
    "apk:release": "cross-env NEXT_PUBLIC_API_BASE=https://crm.udf-party.co.za/api npm run build:mobile && npm run cap:sync && npm run android:assets && cd android && ./gradlew --no-daemon --console=plain :app:assembleRelease :app:dumpReleaseManifest"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/camera": "^6.1.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/geolocation": "^6.1.0",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/share": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "next": "^14.2.21",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.21",
    "typescript": "^5.7.3"
  }
}
