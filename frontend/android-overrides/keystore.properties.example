# ─────────────────────────────────────────────────────────────
# Android release signing config — TEMPLATE.
# Copy to `keystore.properties` (git-ignored) and fill real values.
# app/build.gradle loads this file for the `release` signingConfig.
# NEVER commit keystore.properties or the .jks/.keystore itself.
# ─────────────────────────────────────────────────────────────

# Path to the keystore, relative to frontend/android/ (or absolute).
storeFile=udf-release.jks
storePassword=CHANGE_ME_store_password
keyAlias=udf-release
keyPassword=CHANGE_ME_key_password

# ── Generate a keystore (run once, keep it safe + backed up) ──
#   keytool -genkeypair -v \
#     -keystore udf-release.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias udf-release
#
# Losing the keystore means you cannot publish updates under the same
# signature. Store it (and these passwords) in a secrets manager, not in git.
