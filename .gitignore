# Dependencies
node_modules/
.pnp
.pnp.js

# Builds
dist/
build/
.next/
out/
*.tsbuildinfo

# Deploy build artifacts (off-box tarballs + geo dumps; regenerated by scripts)
deploy/.artifacts/
# Preserved role-audit reports + inputs, snapshotted out of .artifacts before a
# rebuild wipes it (build-offbox.sh does `rm -rf deploy/.artifacts`).
deploy/.audit-snapshots/

# Capacitor / Android (generated native project + APK outputs)
frontend/android/
frontend/ios/
*.apk
*.aab
# …but the tracked native-hardening overrides ARE committed and re-applied
# after `cap add` by frontend/scripts/prepare-android-assets.mjs:
!frontend/android-overrides/

# Env & secrets — NEVER commit real keys
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
*.p12
keystore.properties
# …except the Android trust anchor: that is the server's PUBLIC certificate
# (no private key material) and both network security configs reference it, so
# the APK build must be reproducible from a clean clone.
!frontend/android-overrides/udf_tls_ca.pem
secrets/
kms/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Coverage
coverage/
.nyc_output/

# Local databases
*.sqlite
pgdata/

# Test / verification artifacts (screenshots, temp scripts)
.tmp-verify/
/*.png

# User-uploaded files (runtime data)
backend/uploads/
