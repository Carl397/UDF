# ─────────────────────────────────────────────────────────────
# Android release signing config — TEMPLATE (com.udf.mail).
# The real file is git-ignored and lives at repo-root secrets/android/keystore.properties,
# which app-build.gradle falls back to automatically (../../secrets/android/keystore.properties).
# Copy here ONLY if you must give the mail app its own distinct signing identity.
# NEVER commit keystore.properties or the .jks/.p12/.keystore itself.
# ─────────────────────────────────────────────────────────────

# Path to the keystore, relative to mailapp/android/ (or absolute).
storeFile=../../secrets/android/udf-upload.p12
storePassword=CHANGE_ME_store_password
keyAlias=udf-upload
keyPassword=CHANGE_ME_key_password
